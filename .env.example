# Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================================
# DATABASE
# ============================================================
# Local development (PostgreSQL must be running)
DATABASE_URL="postgresql://postgres:password@localhost:5432/alya_portfolio"
DIRECT_URL="postgresql://postgres:password@localhost:5432/alya_portfolio"

# Production (Supabase / Neon)
# DATABASE_URL="postgresql://user:password@host:5432/alya_portfolio?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://user:password@host:5432/alya_portfolio"

# ============================================================
# AUTHENTICATION
# ============================================================
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-min-32-chars-here"

# Admin user credentials (used in seed script)
ADMIN_EMAIL="alyanisnst@gmail.com"
ADMIN_NAME="Alya Nisrina"
ADMIN_PASSWORD="set-a-strong-local-admin-password"

# ============================================================
# NEON OBJECT STORAGE
# ============================================================
# Neon injects these after `neon link`, `neon env pull`, or `neon deploy`.
# Add the same four values to Vercel for every environment that uses uploads.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT_URL_S3=""
# AWS_REGION=""
# Buckets are declared in neon.ts:
# - portfolio-public: public portfolio media
# - portfolio-private: restricted/private documents

# ============================================================
# APPLICATION
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Alya Nisrina"

# ============================================================
# ANALYTICS (optional)
# ============================================================
# NEXT_PUBLIC_UMAMI_URL="https://your-umami.com"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-website-id"
